# ─────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL Docker container)
# ─────────────────────────────────────────────────────────────
POSTGRES_DB=ewarrant360
POSTGRES_USER=ewarrant
POSTGRES_PASSWORD=StrongPassword123!
DATABASE_URL="postgresql://ewarrant:StrongPassword123!@postgres:5432/ewarrant360?schema=public"

# ─────────────────────────────────────────────────────────────
# AUTH (NextAuth v5 / Auth.js)
# ─────────────────────────────────────────────────────────────
# Generate random key: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-char-string"
AUTH_SECRET="change-this-to-a-secure-random-32-char-string"
AUTH_TRUST_HOST=true

# Public URL (Domain or EC2 IP)
# Examples: "https://ewarrant360.duckdns.org" or "http://YOUR_EC2_IP"
NEXTAUTH_URL="https://ewarrant360.duckdns.org"
AUTH_URL="https://ewarrant360.duckdns.org"
NEXT_PUBLIC_APP_URL="https://ewarrant360.duckdns.org"
NEXT_PUBLIC_APP_NAME="e-warrant360"

# ─────────────────────────────────────────────────────────────
# PLATFORM ADMIN INITIAL SEED ACCOUNT
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@ewarrant360.lk"
ADMIN_PASSWORD="AdminSecurePass123!"
ADMIN_NAME="Platform Super Admin"

# ─────────────────────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────────────────────
NODE_ENV="production"
UPLOAD_MAX_SIZE_MB="10"
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,application/pdf"
